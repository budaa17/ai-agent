{
  "name": "diplom-agent-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 4173",
    "dev:api": "pnpm --dir ../agents run api:v22",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "api:export": "pnpm --dir ../agents run openapi:export:v22",
    "api:generate": "pnpm run api:export && openapi-typescript ../agents/data/openapi/buildwatch-v22.json -o src/api/generated.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "build:with-api": "pnpm run api:generate && pnpm run build",
    "build:agents": "node scripts/build-agents.mjs",
    "check": "pnpm run api:generate && pnpm run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:components": "vitest run src",
    "test:legacy": "node --test tests/*.test.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "audit:marketing": "node scripts/marketing-audit.mjs",
    "audit:platform": "node scripts/platform-browser-audit.mjs",
    "audit:roles": "node scripts/role-browser-audit.mjs",
    "audit:features:setup": "node scripts/full-feature-browser-audit.mjs",
    "audit:features:roles": "node scripts/full-feature-role-audit.mjs",
    "legacy:start": "node server.mjs",
    "verify": "pnpm run check && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@gorules/jdm-editor": "^1.52.0",
    "@tanstack/react-query": "^5.101.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
