NODE_ENV=production
BUILDWATCH_DEPLOYMENT_STAGE=production
PRODUCTION_DATABASE=true
APP_RELEASE=
BUILDWATCH_PUBLIC_BASE_URL=https://buildwatch.example.com
BUILDWATCH_HTTP_PORT=8080

POSTGRES_USER=buildwatch
POSTGRES_PASSWORD=
POSTGRES_DB=buildwatch
BUILDWATCH_DATABASE_URL=postgresql://buildwatch:CHANGE_ME@postgres:5432/buildwatch?schema=public

RABBITMQ_USER=buildwatch
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://buildwatch:CHANGE_ME@rabbitmq:5672

PHASE9_JWT_SECRET=
PHASE9_CURSOR_SECRET=
PHASE9_ARTIFACT_SIGNING_SECRET=
PHASE9_EMAIL_VERIFICATION_SECRET=
PHASE11_METRICS_TOKEN=
PHASE11_BACKUP_SIGNING_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
A1_OPENAI_MODEL=gpt-5.6-luna
A2_OPENAI_MODEL=gpt-5.6-sol
A3_OPENAI_MODEL=gpt-5.6-luna
AGENT_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS=
AGENT_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS=
AGENT_MAX_RUN_COST_MICRO_USD=2000000
AGENT_MAX_TENANT_MONTHLY_COST_MICRO_USD=50000000

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

BUILDWATCH_API_IMAGE=buildwatch-api
BUILDWATCH_OUTBOX_IMAGE=buildwatch-outbox
BUILDWATCH_AGENT_IMAGE=buildwatch-agent
BUILDWATCH_FRONTEND_IMAGE=buildwatch-frontend
BUILDWATCH_OPERATIONS_IMAGE=buildwatch-operations
BUILDWATCH_MIGRATE_IMAGE=buildwatch-migrate

# Billing. The webhook secret must be independent of every API signing secret,
# and production refuses to start against a sandbox store.
BILLING_PROVIDER=STRIPE
BILLING_ENVIRONMENT=live
BILLING_MANUAL_INVOICE_ENABLED=false
BILLING_RETURN_URL_ALLOWLIST=
BILLING_REQUEST_TIMEOUT_MS=15000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_STARTER_MONTH_PRICE_ID=
STRIPE_STARTER_YEAR_PRICE_ID=
STRIPE_BUSINESS_MONTH_PRICE_ID=
STRIPE_BUSINESS_YEAR_PRICE_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Email. Without these signup verification codes and password links cannot be delivered.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=10000
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
