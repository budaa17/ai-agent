    "phase2:images:predict": "tsx src/scripts/predict-a1-image-evaluation.ts",
    "smoke:phase2": "pnpm run check && pnpm run build && pnpm run phase2:gate && pnpm run health",
    "smoke:pdf": "tsx src/scripts/pdf-smoke.ts",
    "health": "tsx src/scripts/health.ts",
    "health:ready": "tsx src/scripts/health.ts --ready",
    "worker": "node dist/scripts/worker.js",
    "queue:replay": "tsx src/scripts/queue-replay.ts",
    "puppeteer:install": "puppeteer browsers install chrome --path .cache/puppeteer",
    "report": "tsx src/scripts/report.ts",
    "a3:enqueue": "tsx src/scripts/a3-enqueue.ts",
    "a3:worker": "tsx src/scripts/a3-worker.ts",
    "a3:drafts": "tsx src/scripts/a3-drafts.ts",
    "a3:review": "tsx src/scripts/a3-review.ts"
