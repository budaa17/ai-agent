    "phase6:v22:gate": "pnpm run phase5:v22:gate && pnpm run test:design-intake:v22 && pnpm run eval:design-intake:v22",
    "baseline:v22": "tsx src/scripts/generate-buildwatch-v22-baseline.ts",
    "test:baseline-generation:v22": "vitest run tests/contracts/buildwatch-v22-commercial.test.ts tests/baseline-generation",
    "eval:baseline-generation:v22": "tsx src/scripts/evaluate-buildwatch-v22-baseline-generation.ts",
    "phase7:v22:gate": "pnpm run phase6:v22:gate && pnpm run test:baseline-generation:v22 && pnpm run eval:baseline-generation:v22",
