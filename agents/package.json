{
  "name": "diplom-agents",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Script-first TypeScript environment for diploma agents, tools, data, and evaluation.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "docs:check:v22": "tsx src/scripts/validate-buildwatch-v22-docs.ts",
    "test:contracts:v22": "vitest run tests/contracts/buildwatch-v22-design.test.ts tests/contracts/buildwatch-v22-commercial.test.ts tests/contracts/buildwatch-v22-operations.test.ts tests/contracts/buildwatch-v22-versioning.test.ts",
    "phase1:v22:gate": "pnpm run docs:check:v22 && pnpm run check && pnpm run test:contracts:v22",
    "simulation:v22:generate": "tsx src/scripts/generate-buildwatch-v22-simulation.ts",
    "test:simulation:v22": "vitest run tests/simulation/buildwatch-simulation.test.ts tests/simulation/buildwatch-v22-operational-simulation.test.ts",
