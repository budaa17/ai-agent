    "a2:enqueue": "tsx src/scripts/a2-enqueue.ts",
    "a2:worker": "tsx src/scripts/a2-worker.ts",
    "chat": "tsx src/scripts/chat.ts",
    "structure": "tsx src/scripts/structure.ts",
    "a1:intake": "tsx src/scripts/a1-intake.ts",
