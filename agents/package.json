    "agent:a1:apply-simulation": "tsx src/scripts/a1-daily-review.ts apply-simulation",
    "eval": "tsx src/scripts/evaluate.ts",
    "eval:a1": "tsx src/scripts/evaluate.ts",
    "eval:a1:daily": "tsx src/scripts/evaluate-daily-reports.ts",
    "eval:a2": "tsx src/scripts/evaluate-a2.ts",
    "eval:a3": "tsx src/scripts/evaluate-a3.ts",
    "eval:a4": "tsx src/scripts/evaluate-a4.ts",
    "eval:agents": "tsx src/scripts/evaluate-agents.ts",
    "phase2:gate": "tsx src/scripts/phase2-gate.ts",
    "phase2:release-gate": "tsx src/scripts/phase2-gate.ts --release",
