    "lint:fix": "oxlint --fix src tests prisma",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker --config .docker compose up -d",
    "docker:down": "docker --config .docker compose down",
    "db:generate": "prisma generate",
