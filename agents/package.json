    "smoke:phase10:postgres:v22": "tsx src/scripts/smoke-buildwatch-v22-phase10-postgres.ts",
    "smoke:billing:postgres": "tsx src/scripts/smoke-billing-domain-postgres.ts",
    "smoke:billing:lifecycle": "tsx src/scripts/smoke-billing-lifecycle-postgres.ts",
