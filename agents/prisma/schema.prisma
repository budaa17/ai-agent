generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum WorkItemStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum CostCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  SOFTWARE
  TRAVEL
  OTHER
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  REJECTED
  FAILED
  DEGRADED
}

enum AgentToolCallStatus {
  COMPLETED
  FAILED
  REJECTED
}

enum RegistrationSourceType {
  TEXT
  IMAGE
  TEXT_IMAGE
}

enum RegistrationDraftStatus {
  PROCESSING
  READY_FOR_REVIEW
  NEEDS_CORRECTION
  APPROVED
  APPLIED
  REJECTED
  FAILED
}

enum A3DocumentType {
  PROJECT_REPORT
  EXECUTIVE_CONCLUSION
  OFFICIAL_LETTER
}

enum A3DocumentDraftStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum IdentityRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  PROJECT_MANAGER
  ENGINEER
  SITE_SUPERVISOR
  STOREKEEPER
  OBSERVER
}

enum IdentityUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_OPERATOR
  PLATFORM_AUDITOR
}

enum PlatformAuditResult {
  SUCCESS
  DENIED
  FAILED
}

enum PlatformIncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PlatformIncidentState {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  REOPENED
}

enum PlatformSupportAccessState {
  REQUESTED
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum PlatformSupportAccessEventType {
  REQUESTED
  APPROVED
  DENIED
  REVOKED
  EXPIRED
  USED
}

enum PlatformIncidentEventType {
  OPENED
  SEVERITY_CHANGED
  ACKNOWLEDGED
  ASSIGNED
  RESOLVED
  AUTO_RESOLVED
  REOPENED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SecurityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum VersionLifecycleStatus {
  DRAFT
  REVIEW_REQUIRED
  APPROVED
  APPLIED
  SUPERSEDED
  REJECTED
  CANCELLED
}

enum ReviewTargetType {
  REGISTRATION_DRAFT
  QUANTITY_TAKEOFF
  ESTIMATE
  SCHEDULE
  BASELINE
  DAILY_WORK_PLAN
  DAILY_REPORT
  PROGRESS_VERIFICATION
  RECOVERY_SCENARIO
}

enum ReviewTaskStatus {
  DRAFT
  REVIEW_REQUIRED
  APPROVED
  APPLIED
  SUPERSEDED
  REJECTED
  CANCELLED
}

enum ReviewDecisionType {
  SUBMIT
  APPROVE
  REJECT
  CANCEL
  APPLY
  SUPERSEDE
  CORRECT
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum FileAssetStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum DesignDocumentType {
  DRAWING
  SPECIFICATION
  BOQ
  METHOD_STATEMENT
  OTHER
}

enum SourceVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REVERSAL
}

enum PhotoEvidenceStatus {
  UPLOADED
  VALIDATED
  LINKED
  REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AppliedCommandStatus {
  APPLIED
  REPLAYED
}

enum TenantLifecycleStatus {
  PENDING_PAYMENT
  ACTIVE
  PAYMENT_GRACE
  SUSPENDED
  ARCHIVED
}

enum BillingProviderKind {
  STRIPE
  LEMON_SQUEEZY
  PADDLE
  MANUAL_INVOICE
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
  CUSTOM
}

enum BillingEventProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  REFUNDED
}

enum CompanySignupIntentStatus {
  PENDING_VERIFICATION
  VERIFIED
  CHECKOUT_STARTED
  COMPLETED
  EXPIRED
  ABANDONED
}

model Tenant {
  id                  String                       @id @default(cuid())
  slug                String                       @unique
  name                String
  lifecycleStatus     TenantLifecycleStatus        @default(PENDING_PAYMENT)
  accessChangedAt     DateTime?
  accessReason        String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  projects            Project[]
  workItems           WorkItem[]
  dependencies        WorkItemDependency[]
  snapshots           WorkItemSnapshot[]
  costEntries         CostEntry[]
  agentRuns           AgentRun[]
  agentFeedback       AgentFeedback[]
  agentUsageBudgets   AgentUsageBudget[]
  registrationDrafts  RegistrationDraft[]
  a3DocumentDrafts    A3DocumentDraft[]
  users               User[]
  invitations         TenantInvitation[]
  materialCatalogs    MaterialCatalog[]
  normCatalogs        NormCatalog[]
  priceCatalogs       PriceCatalog[]
  ruleCatalogs        RuleCatalog[]
  approvalMatrices    ApprovalMatrix[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  idempotencyRecords  IdempotencyRecord[]
  appliedCommands     AppliedCommand[]
  consumedEvents      ConsumedEvent[]
  notifications       Notification[]
  supportAccessGrants PlatformSupportAccessGrant[]
  billingCustomer     BillingCustomer?
  subscriptions       TenantSubscription[]
  entitlementSnapshot TenantEntitlementSnapshot?
  invoices            BillingInvoice[]

  @@index([lifecycleStatus])
}

model Project {
  id                  String                   @id @default(cuid())
  tenantId            String
  code                String
  name                String
  description         String?
  location            String?
  status              ProjectStatus            @default(PLANNED)
  plannedStart        DateTime
  plannedEnd          DateTime
  budget              Decimal                  @db.Decimal(18, 2)
  actualCost          Decimal                  @default(0) @db.Decimal(18, 2)
  rowVersion          Int                      @default(1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems           WorkItem[]
  dependencies        WorkItemDependency[]
  snapshots           WorkItemSnapshot[]
  costEntries         CostEntry[]
  agentRuns           AgentRun[]
  agentFeedback       AgentFeedback[]
  registrationDrafts  RegistrationDraft[]
  a3DocumentDrafts    A3DocumentDraft[]
  members             ProjectMember[]
  fileAssets          FileAsset[]
  designDocuments     DesignDocument[]
  quantityVersions    QuantityTakeoffVersion[]
  estimateVersions    EstimateVersion[]
  scheduleVersions    ScheduleVersion[]
  baselineVersions    BaselineVersion[]
  crews               Crew[]
  equipment           Equipment[]
  dailyWorkPlans      DailyWorkPlan[]
  dailyReports        DailyReport[]
  stockMovements      StockMovement[]
  verifications       ProgressVerification[]
  dailyVariances      DailyVariance[]
  forecastSnapshots   ForecastSnapshot[]
  recoveryScenarios   RecoveryScenario[]
  reviewTasks         ReviewTask[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  idempotencyRecords  IdempotencyRecord[]
  appliedCommands     AppliedCommand[]
  notifications       Notification[]
  agentToolReadModels AgentToolReadModel[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model WorkItem {
  id               String               @id @default(cuid())
  tenantId         String
  projectId        String
  code             String
  name             String
  description      String?
  assigneeName     String?
  status           WorkItemStatus       @default(PLANNED)
  priority         WorkItemPriority     @default(MEDIUM)
  plannedStart     DateTime
  plannedEnd       DateTime
  actualStart      DateTime?
  actualEnd        DateTime?
  progressPercent  Int                  @default(0)
  budget           Decimal              @db.Decimal(18, 2)
  actualCost       Decimal              @default(0) @db.Decimal(18, 2)
  isCritical       Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorLinks WorkItemDependency[] @relation("DependencyPredecessor")
  successorLinks   WorkItemDependency[] @relation("DependencySuccessor")
  snapshots        WorkItemSnapshot[]
  costEntries      CostEntry[]

  @@unique([projectId, code])
  @@index([tenantId, projectId, status])
  @@index([projectId, plannedEnd])
}

model WorkItemDependency {
  id            String         @id @default(cuid())
  tenantId      String
  projectId     String
  predecessorId String
  successorId   String
  type          DependencyType @default(FINISH_TO_START)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor   WorkItem       @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     WorkItem       @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId, type])
  @@index([tenantId, projectId])
  @@index([successorId])
}

model WorkItemSnapshot {
  id              String         @id @default(cuid())
  tenantId        String
  projectId       String
  workItemId      String
  capturedAt      DateTime
  status          WorkItemStatus
  progressPercent Int
  actualCost      Decimal        @db.Decimal(18, 2)
  note            String?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem        WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, capturedAt])
  @@index([tenantId, projectId, capturedAt])
}

model CostEntry {
  id          String       @id @default(cuid())
  tenantId    String
  projectId   String
  workItemId  String
  reference   String
  occurredAt  DateTime
  category    CostCategory
  amount      Decimal      @db.Decimal(18, 2)
  description String
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, reference])
  @@index([tenantId, projectId, occurredAt])
  @@index([workItemId])
}

model AgentRun {
  id                    String            @id @default(cuid())
  tenantId              String
  projectId             String
  agentType             String
  status                AgentRunStatus    @default(RUNNING)
  trigger               String            @default("REQUEST")
  requestId             String?
  eventId               String?
  promptVersion         String            @default("legacy")
  toolBundleVersion     String            @default("legacy")
  outputSchemaVersion   Int               @default(1)
  provider              String
  modelId               String
  asOf                  DateTime
  request               Json
  researchText          String?
  output                Json?
  validation            Json?
  inputTokens           Int               @default(0)
  outputTokens          Int               @default(0)
  cachedInputTokens     Int               @default(0)
  reasoningTokens       Int               @default(0)
  estimatedCostMicroUsd Int               @default(0)
  actualCostMicroUsd    Int?
  latencyMs             Int               @default(0)
  retryCount            Int               @default(0)
  failureCategory       String            @default("NONE")
  traceId               String?
  dataSnapshotVersion   String            @default("legacy")
  outputSha256          String?
  contentLoggingEnabled Boolean           @default(false)
  errorMessage          String?
  langfuseTraceId       String?
  startedAt             DateTime          @default(now())
  completedAt           DateTime?
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolCalls             AgentToolCall[]
  documentDrafts        A3DocumentDraft[]
  feedback              AgentFeedback[]

  @@index([tenantId, projectId, startedAt])
  @@index([tenantId, requestId])
  @@index([tenantId, eventId])
  @@index([status, startedAt])
  @@index([failureCategory, startedAt])
  @@index([langfuseTraceId])
  @@index([traceId])
}

model AgentToolCall {
  id                    String              @id @default(cuid())
  agentRunId            String
  schemaVersion         Int                 @default(1)
  stepNumber            Int
  toolCallId            String
  toolName              String
  input                 Json
  output                Json?
  authorizedScopeSha256 String?
  argumentsSha256       String?
  rowCount              Int                 @default(0)
  returnedRowCount      Int                 @default(0)
  truncated             Boolean             @default(false)
  outputSha256          String?
  status                AgentToolCallStatus
  failureCategory       String              @default("NONE")
  errorMessage          String?
  durationMs            Int?
  occurredAt            DateTime            @default(now())
  createdAt             DateTime            @default(now())
  agentRun              AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, toolCallId])
  @@index([agentRunId, stepNumber])
  @@index([toolName, status, occurredAt])
}

model AgentFeedback {
  id                  String    @id
  agentRunId          String?
  tenantId            String
  projectId           String
  agentType           String
  feedbackType        String
  artifactId          String
  fieldPath           String?
  beforeValue         Json?
  afterValue          Json?
  reason              String
  category            String
  reviewerId          String
  reviewedAt          DateTime
  promptVersion       String
  modelVersion        String?
  toolBundleVersion   String
  dataSnapshotVersion String
  regressionStatus    String
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun            AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, agentType, reviewedAt])
  @@index([artifactId, reviewedAt])
  @@index([regressionStatus, reviewedAt])
}

model AgentUsageBudget {
  tenantId     String
  month        String
  usedMicroUsd Int      @default(0)
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, month])
  @@index([month, usedMicroUsd])
}

model RegistrationDraft {
  id                  String                  @id
  requestId           String                  @unique
  tenantId            String
  projectId           String?
  sourceType          RegistrationSourceType
  sourceText          String?
  sourceImage         Bytes?
  sourceFileName      String?
  sourceMediaType     String?
  sourceImageMetadata Json?
  sourceSha256        String
  referenceDate       DateTime
  status              RegistrationDraftStatus @default(PROCESSING)
  rowVersion          Int                     @default(1)
  provider            String
  modelId             String
  structuredData      Json?
  confidence          Json?
  validation          Json?
  errorMessage        String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  completedAt         DateTime?
  reviewedAt          DateTime?
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([projectId, createdAt])
  @@index([sourceSha256])
}

model A3DocumentDraft {
  id           String                @id
  requestId    String
  tenantId     String
  projectId    String
  agentRunId   String?
  type         A3DocumentType
  status       A3DocumentDraftStatus @default(PENDING_APPROVAL)
  title        String
  content      Json
  sourceAsOf   DateTime
  trigger      String
  artifactPath String?
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  reviewedAt   DateTime?
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, projectId, requestId, type])
  @@index([tenantId, projectId, status, createdAt])
  @@index([agentRunId])
}

model User {
  id                   String                @id @default(cuid())
  tenantId             String
  email                String
  emailNormalized      String
  displayName          String
  tenantRole           IdentityRole          @default(OBSERVER)
  status               IdentityUserStatus    @default(INVITED)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  tokenVersion         Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential           UserCredential?
  memberships          ProjectMember[]
  refreshSessions      RefreshSession[]
  securityTokens       SecurityToken[]
  invitationsSent      TenantInvitation[]    @relation("InvitationSender")
  invitationsAccepted  TenantInvitation[]    @relation("InvitationAcceptor")
  uploadedFiles        FileAsset[]
  artifactAccessGrants ArtifactAccessGrant[]

  @@unique([tenantId, emailNormalized])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  // Sign-in resolves the tenant from the email alone, so this lookup crosses
  // tenants and cannot use the composite unique index above.
  @@index([emailNormalized])
}

model UserCredential {
  userId            String    @id
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Platform operators are intentionally not tenant users. Keeping this
// identity graph separate prevents a platform token from becoming an implicit
// tenant/project wildcard and gives Control Tower actions their own audit
// trail. See ADR 0017.
model PlatformPrincipal {
  id                     String                       @id @default(cuid())
  email                  String
  emailNormalized        String                       @unique
  displayName            String
  role                   PlatformRole                 @default(PLATFORM_AUDITOR)
  status                 IdentityUserStatus           @default(ACTIVE)
  tokenVersion           Int                          @default(1)
  lastLoginAt            DateTime?
  /// Set once a second factor is enrolled. Production refuses platform sign-in
  /// while this is null, so the console cannot ship without MFA behind it.
  mfaEnrolledAt          DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  credential             PlatformCredential?
  refreshSessions        PlatformRefreshSession[]
  auditLogs              PlatformAuditLog[]           @relation("PlatformAuditActor")
  acknowledgedIncidents  PlatformIncident[]           @relation("PlatformIncidentAcknowledger")
  assignedIncidents      PlatformIncident[]           @relation("PlatformIncidentAssignee")
  resolvedIncidents      PlatformIncident[]           @relation("PlatformIncidentResolver")
  incidentEvents         PlatformIncidentEvent[]      @relation("PlatformIncidentEventActor")
  requestedSupportGrants PlatformSupportAccessGrant[] @relation("PlatformSupportRequester")
  approvedSupportGrants  PlatformSupportAccessGrant[] @relation("PlatformSupportApprover")
  revokedSupportGrants   PlatformSupportAccessGrant[] @relation("PlatformSupportRevoker")
  supportAccessEvents    PlatformSupportAccessEvent[] @relation("PlatformSupportEventActor")

  @@index([status, role])
  @@index([mfaEnrolledAt])
}

model PlatformCredential {
  principalId       String            @id
  passwordHash      String
  passwordChangedAt DateTime          @default(now())
  failedLoginCount  Int               @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  principal         PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)
}

model PlatformRefreshSession {
  id              String            @id @default(cuid())
  principalId     String
  familyId        String
  tokenHash       String            @unique
  parentSessionId String?
  replacedById    String?
  deviceName      String?
  userAgent       String?
  ipAddressHash   String?
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  reuseDetectedAt DateTime?
  createdAt       DateTime          @default(now())
  principal       PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@index([principalId, expiresAt])
  @@index([familyId])
}

model PlatformAuditLog {
  id               String              @id @default(cuid())
  actorPrincipalId String?
  actorRole        PlatformRole?
  tenantId         String?
  action           String
  entityType       String
  entityId         String
  result           PlatformAuditResult @default(SUCCESS)
  reason           String?
  correlationId    String
  sourceVersion    String?
  beforeHash       String?
  afterHash        String?
  metadata         Json
  occurredAt       DateTime            @default(now())
  actor            PlatformPrincipal?  @relation("PlatformAuditActor", fields: [actorPrincipalId], references: [id], onDelete: SetNull)

  @@index([actorPrincipalId, occurredAt])
  @@index([correlationId])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@index([occurredAt, id])
  @@index([tenantId, occurredAt])
}

/// One row per deduplicated platform signal. The alert evaluator upserts by
/// `signalId`, so a rule that keeps firing stays a single incident with history
/// rather than becoming a new row on every evaluation.
model PlatformIncident {
  id                String                   @id @default(cuid())
  signalId          String                   @unique
  ruleKey           String
  ruleVersion       String
  severity          PlatformIncidentSeverity
  state             PlatformIncidentState    @default(OPEN)
  title             String
  impact            String
  recommendedAction String
  diagnosticsHref   String
  tenantId          String?
  tenantName        String?
  agentType         String?
  component         String?
  evidence          Json
  firstEvidenceAt   DateTime?
  lastEvidenceAt    DateTime
  openedAt          DateTime                 @default(now())
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  assignedToId      String?
  assignedAt        DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNote    String?
  autoResolvedAt    DateTime?
  reopenCount       Int                      @default(0)
  rowVersion        Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  acknowledgedBy    PlatformPrincipal?       @relation("PlatformIncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  assignedTo        PlatformPrincipal?       @relation("PlatformIncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy        PlatformPrincipal?       @relation("PlatformIncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  events            PlatformIncidentEvent[]

  @@index([state, severity, lastEvidenceAt])
  @@index([tenantId, state])
  @@index([agentType, state])
  @@index([openedAt])
}

/// Append-only lifecycle history. A resolved incident keeps every transition so
/// an auto-resolve followed by a reopen is still explainable months later.
model PlatformIncidentEvent {
  id               String                    @id @default(cuid())
  incidentId       String
  type             PlatformIncidentEventType
  fromState        PlatformIncidentState?
  toState          PlatformIncidentState
  actorPrincipalId String?
  actorRole        PlatformRole?
  reason           String?
  note             String?
  correlationId    String
  /// Set on operator-driven transitions so a retried request replays the
  /// original event instead of writing a second one.
  idempotencyKey   String?
  metadata         Json
  occurredAt       DateTime                  @default(now())
  incident         PlatformIncident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor            PlatformPrincipal?        @relation("PlatformIncidentEventActor", fields: [actorPrincipalId], references: [id], onDelete: SetNull)

  @@unique([incidentId, idempotencyKey])
  @@index([incidentId, occurredAt])
  @@index([correlationId])
}

/// Persisted offline evaluation history. `EvalCase` holds the case catalogue;
/// this holds what actually happened when a suite was run against a release,
/// which is what makes a quality trend possible at all.
model PlatformEvaluationRun {
  id                String   @id @default(cuid())
  suiteKey          String
  suiteVersion      String
  agentType         String
  agentRelease      String
  promptVersion     String
  toolBundleVersion String
  provider          String
  modelId           String
  caseCount         Int
  passedCount       Int
  failedCount       Int
  skippedCount      Int      @default(0)
  startedAt         DateTime
  completedAt       DateTime
  /// CI run, commit or script identity the result came from.
