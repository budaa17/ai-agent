/// Time-boxed, read-only, masked access a platform operator may be granted into
/// one tenant. There is no silent impersonation: a grant is requested, approved
/// by a second person, expires on its own and leaves an append-only trail.
model PlatformSupportAccessGrant {
  id                String                       @id @default(cuid())
  ticketReference   String
  reason            String
  tenantId          String
  projectId         String?
  allowedOperations String[]
  /// Always true today: the grant never unmasks tenant content.
  maskedOnly        Boolean                      @default(true)
  state             PlatformSupportAccessState   @default(REQUESTED)
  requestedById     String
  requestedAt       DateTime                     @default(now())
  approvedById      String?
  approvedAt        DateTime?
  startsAt          DateTime?
  expiresAt         DateTime
  decisionReason    String?
  revokedById       String?
  revokedAt         DateTime?
  useCount          Int                          @default(0)
  lastUsedAt        DateTime?
  rowVersion        Int                          @default(1)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy       PlatformPrincipal            @relation("PlatformSupportRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy        PlatformPrincipal?           @relation("PlatformSupportApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  revokedBy         PlatformPrincipal?           @relation("PlatformSupportRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  events            PlatformSupportAccessEvent[]

  @@index([state, expiresAt])
  @@index([tenantId, state])
  @@index([requestedById, requestedAt])
  @@index([requestedAt])
}

/// Append-only history for a support access grant.
model PlatformSupportAccessEvent {
  id               String                         @id @default(cuid())
  grantId          String
  type             PlatformSupportAccessEventType
  fromState        PlatformSupportAccessState?
  toState          PlatformSupportAccessState
  actorPrincipalId String?
  actorRole        PlatformRole?
  reason           String?
  correlationId    String
  idempotencyKey   String?
  metadata         Json
  occurredAt       DateTime                       @default(now())
  grant            PlatformSupportAccessGrant     @relation(fields: [grantId], references: [id], onDelete: Cascade)
  actor            PlatformPrincipal?             @relation("PlatformSupportEventActor", fields: [actorPrincipalId], references: [id], onDelete: SetNull)

  @@unique([grantId, idempotencyKey])
  @@index([grantId, occurredAt])
  @@index([correlationId])
}

