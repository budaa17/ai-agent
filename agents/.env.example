NODE_ENV="development"
APP_ENV="local"
APP_RELEASE="dev"
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/diplom_agents?schema=public"
PRODUCTION_DATABASE="false"

# BuildWatch v2.2 Phase 9 API/auth. For local development one random secret
# of at least 32 bytes can back the local signers. Production must use four
# independent secrets supplied by a secret manager.
PHASE9_API_HOST="127.0.0.1"
PHASE9_API_PORT="4180"
PHASE9_PUBLIC_BASE_URL="http://127.0.0.1:4180"
BUILDWATCH_PUBLIC_BASE_URL="http://127.0.0.1:4173"
PHASE9_DEVELOPMENT_SECRET="replace-with-at-least-32-random-bytes"
PHASE9_JWT_SECRET=""
PHASE9_CURSOR_SECRET=""
PHASE9_ARTIFACT_SIGNING_SECRET=""
PHASE9_EMAIL_VERIFICATION_SECRET=""
PHASE9_ARTIFACT_ROOT="data/artifacts"
PHASE9_ARTIFACT_STORAGE_PROVIDER="local"
# Server-side only. For Render set provider=supabase and create a private bucket.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="buildwatch-artifacts"
PHASE9_BOOTSTRAP_EMAIL=""
PHASE9_BOOTSTRAP_PASSWORD=""
RABBITMQ_URL=""

# Phase 11 production hardening. Production requires independent secrets,
# HTTPS public URL, RabbitMQ, ClamAV, and a private metrics token.
PHASE11_TRUST_PROXY_HOPS="0"
PHASE11_RATE_LIMIT_WINDOW_MS="60000"
PHASE11_API_RATE_LIMIT_MAX="300"
PHASE11_AUTH_RATE_LIMIT_MAX="20"
PHASE11_REQUEST_TIMEOUT_MS="60000"
PHASE11_HEADERS_TIMEOUT_MS="65000"
PHASE11_KEEP_ALIVE_TIMEOUT_MS="5000"
PHASE11_MAX_ARTIFACT_BYTES="26214400"
PHASE11_METRICS_TOKEN=""
PHASE11_REQUIRE_EXTERNAL_MALWARE_SCAN="false"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
PHASE11_BACKUP_ROOT="backups"
PHASE11_BACKUP_SIGNING_KEY=""
PHASE11_ALLOW_PRODUCTION_RESTORE="false"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
A1_OPENAI_MODEL="gpt-5.6-luna"
A2_OPENAI_MODEL="gpt-5.6-sol"
A3_OPENAI_MODEL="gpt-5.6-luna"

# Worker image entry point: a1, a2, a3, or analysis.
AGENT_WORKER="a1"
AGENT_WORKER_CONCURRENCY="1"
AGENT_JOB_RETRY_LIMIT="3"
AGENT_JOB_RETRY_DELAY_SECONDS="30"
AGENT_JOB_HEARTBEAT_SECONDS="60"
AGENT_HEALTH_REQUIRE_OPENAI="false"

# Runtime model safety. Cost values use micro-USD.
# Before production, replace both zero price values with the current
# input/output price of the configured OpenAI model per one million tokens.
AGENT_MAX_INPUT_TOKENS="100000"
AGENT_MAX_OUTPUT_TOKENS="16000"
AGENT_MAX_RUN_COST_MICRO_USD="2000000"
AGENT_MAX_TENANT_MONTHLY_COST_MICRO_USD="50000000"
AGENT_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS="0"
AGENT_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS="0"
AGENT_MODEL_TIMEOUT_MS="90000"
AGENT_MODEL_MAX_RETRIES="2"
AGENT_MODEL_INITIAL_RETRY_DELAY_MS="500"
AGENT_CIRCUIT_FAILURE_THRESHOLD="3"
AGENT_CIRCUIT_COOLDOWN_MS="60000"

A1_TENANT_ID="tenant-demo"
A1_PROJECT="project-atlas"
A1_PERSIST="true"

CHAT_TENANT_ID="tenant-demo"
CHAT_PROJECT_IDS="project-atlas"
CHAT_MAX_STEPS="15"

LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASEURL="https://cloud.langfuse.com"
LANGFUSE_RECORD_CONTENT="false"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

ANALYSIS_TENANT_ID="tenant-demo"
ANALYSIS_PROJECT="project-atlas"
ANALYSIS_AS_OF="2026-03-01T00:00:00.000Z"
ANALYSIS_ANSWER_KEY="data/answer-key.json"

A2_TENANT_ID="tenant-demo"
A2_PROJECT="project-atlas"
A2_AS_OF="2026-03-01T00:00:00.000Z"
A2_MAX_STEPS="8"
A2_NIGHTLY_CRON="0 1 * * *"
A2_TIMEZONE="Asia/Ulaanbaatar"
A2_SCHEDULE_PROJECTS=""
A2_SCHEDULE_REFRESH_MS="300000"

A3_TENANT_ID="tenant-demo"
A3_PROJECT="project-atlas"
A3_AS_OF="2026-03-01T00:00:00.000Z"
A3_ANSWER_KEY="data/answer-key.json"
A3_NARRATIVE_MODE="deterministic"
A3_SCHEDULE_CRON="0 7 * * 1"
A3_TIMEZONE="Asia/Ulaanbaatar"
A3_SCHEDULE_PROJECTS="project-atlas"
A3_SCHEDULE_AS_OF=""
A3_NO_PDF="false"
A3_AUTOMATION_OUTPUT_ROOT="data/reports/automated"

PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_DISABLE_SANDBOX="false"
PUPPETEER_SKIP_DOWNLOAD="false"

# Production demo seed remains blocked unless the exact acknowledgement
# printed by the seed command is deliberately configured.
# ALLOW_PRODUCTION_SEED=""

# --- Billing (landing-page-roadmap.md §8, Phase 3) ---------------------------
# Stripe is the production self-service subscription rail. A local developer
# without Stripe credentials can still boot using the non-paying manual stub.
# BILLING_PROVIDER="STRIPE"
BILLING_ENVIRONMENT="sandbox"
BILLING_MANUAL_INVOICE_ENABLED="false"
BILLING_RETURN_URL_ALLOWLIST="http://127.0.0.1:4173"
BILLING_REQUEST_TIMEOUT_MS="15000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PORTAL_CONFIGURATION_ID=""
STRIPE_AUTOMATIC_TAX_ENABLED="false"
STRIPE_STARTER_MONTH_PRICE_ID=""
STRIPE_STARTER_YEAR_PRICE_ID=""
STRIPE_BUSINESS_MONTH_PRICE_ID=""
STRIPE_BUSINESS_YEAR_PRICE_ID=""
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# --- Email (landing-page-roadmap.md §26) -----------------------------------
# With no SMTP_HOST/SMTP_FROM the API logs what it would have sent and, outside
# production, prints the short code so a developer can finish the signup flow.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_REPLY_TO=""
